# Copie para .env e ajuste. Projeto local/single-user (Handoff §13, com desvios
# do PLAN.md: sem auth, acesso só em localhost).
DEBUG=1
SECRET_KEY=troque-por-uma-chave-secreta-qualquer
DATABASE_URL=postgres://planejador:dev@db:5432/planejador
REDIS_URL=redis://redis:6379/0
# 'web' na lista: o agente (worker Celery) e o MCP server chamam a API pelo
# nome do serviço do compose — sem ele o Django devolve 400 DisallowedHost.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
# Origem local do frontend (Vite=5173, CRA/Next=3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DJANGO_SETTINGS_MODULE=config.settings
# Planejamento assistido por IA (Ollama local — Fase A). IA_PLANEJAMENTO_ENABLED=0
# desliga a IA (entrega só o plano base do solver).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=300
IA_PLANEJAMENTO_ENABLED=1
# Provider da IA de planejamento/cenários (forma "1 chamada + JSON schema"). Separado
# do AGENTE_PROVIDER abaixo de propósito (formas e necessidades distintas).
#   LLM_PROVIDER=ollama    → local (reusa OLLAMA_* acima; default, nada muda local)
#   LLM_PROVIDER=anthropic → API remota (pip install anthropic; exige ANTHROPIC_API_KEY
#                            abaixo e LLM_MODEL — este é OBRIGATÓRIO, sem default)
#   LLM_PROVIDER=mock      → no-op determinístico, sem rede (CI/demo sem Ollama)
LLM_PROVIDER=ollama
# LLM_MODEL=claude-haiku-4-5-20251001
# Calibração da estimativa de tempo do plano (opcionais; têm default no settings).
# PLANEJAR_TEMPO_BASE_S=55
# PLANEJAR_TEMPO_POR_TAREFA_S=3

# Agente conversacional (Marco C4, o cérebro). AGENTE_ENABLED=0 desliga (o painel
# degrada com ia_indisponivel). O provider é trocável:
#   AGENTE_PROVIDER=ollama    → cérebro local (reusa OLLAMA_* acima; grátis, fraco
#                               para tool use multi-turno)
#   AGENTE_PROVIDER=anthropic → API remota (pip install anthropic; exige
#                               ANTHROPIC_API_KEY e AGENTE_MODEL)
AGENTE_ENABLED=1
AGENTE_PROVIDER=ollama
AGENTE_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
# API_BASE_URL não fica mais aqui: as ferramentas do agente chamam os services
# em processo (PR0 da Fase 0B). Só o servidor MCP usa a variável, e o
# docker-compose.yml já a define no serviço `mcp`.

# Telemetria das chamadas de IA (Fase 0A.3). Um registro JSONL por chamada, com
# duração, tokens e tok/s — é o dado que decide IA local vs API na Fase 2.
# NUNCA grava conteúdo (prompt/resposta), nem atrás de flag. O default cai em
# .telemetria/llm.jsonl dentro do projeto (gitignorado), visível no host porque
# o compose monta `.:/app`. Ler com: jq -s . .telemetria/llm.jsonl
TELEMETRIA_ENABLED=1
# TELEMETRIA_JSONL=/app/.telemetria/llm.jsonl

# Feriados regionais (Marco C8). FERIADOS_UF liga a camada estadual (offline,
# lib holidays; vazio desliga). Municipais: admin > Feriados locais (Curitiba
# já vem semeado com 08/09 — Nossa Senhora da Luz dos Pinhais).
FERIADOS_UF=PR
